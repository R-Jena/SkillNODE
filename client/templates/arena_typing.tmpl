{{define "arena_typing"}}
<div id="view-activity-typing" class="page-view flex-col-fill" style="gap: 20px; padding-bottom: 48px; display: none;">

  <!-- Hero Header -->
  <div class="card" style="padding: 24px 28px; background: linear-gradient(135deg, var(--surface), var(--surface-2)); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px;">
    <div>
      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
        <span class="badge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8;">SPEED LAB</span>
        <span id="typingFairPlayBadge" style="display: inline-flex; align-items: center; gap: 5px; font-size: 0.72rem; font-weight: 700; color: #10b981; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.2); padding: 2px 8px; border-radius: 999px;">
          <i class="fas fa-shield-alt"></i> Focus Active
        </span>
      </div>
      <div class="display-title" style="font-size: 1.45rem; color: var(--text);">Typing Velocity & Cadence Telemetry</div>
    </div>
    <div style="display: flex; align-items: center; gap: 8px;">
      <button id="typingResetBtn" class="btn btn-secondary btn-sm" style="border-radius: 9999px; gap: 6px;">
        <i class="fas fa-redo-alt"></i> New Passage
      </button>
      <a href="#/activities" class="btn btn-ghost btn-sm" style="border-radius: 9999px;">
        Exit to Labs
      </a>
    </div>
  </div>

  <!-- Telemetry HUD Bar (WPM, Accuracy, Progress, Elapsed) -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px;">
    <div class="metric-box" style="text-align: center;">
      <div class="label-sm" style="color: var(--text-faint); margin-bottom: 4px;">Velocity (WPM)</div>
      <div id="typingLiveWpm" style="font-size: 2rem; font-weight: 800; color: var(--accent-bright);">0</div>
    </div>
    <div class="metric-box" style="text-align: center;">
      <div class="label-sm" style="color: var(--text-faint); margin-bottom: 4px;">Accuracy</div>
      <div id="typingLiveAccuracy" style="font-size: 2rem; font-weight: 800; color: #10b981;">100%</div>
    </div>
    <div class="metric-box" style="text-align: center;">
      <div class="label-sm" style="color: var(--text-faint); margin-bottom: 4px;">Progress</div>
      <div id="typingLiveProgress" style="font-size: 2rem; font-weight: 800; color: var(--text);">0%</div>
    </div>
    <div class="metric-box" style="text-align: center;">
      <div class="label-sm" style="color: var(--text-faint); margin-bottom: 4px;">Elapsed</div>
      <div id="typingLiveElapsed" style="font-size: 2rem; font-weight: 800; color: var(--text-muted);">0.0s</div>
    </div>
  </div>

  <!-- Progress Bar Line -->
  <div class="timer-bar-wrap" style="height: 6px; background: var(--surface-2); border-radius: 999px; overflow: hidden; border: 1px solid var(--border-subtle);">
    <div id="typingProgressBar" style="height: 100%; width: 0%; background: linear-gradient(90deg, var(--accent), var(--accent-bright)); transition: width 0.1s ease;"></div>
  </div>

  <!-- Interactive Passage & Execution Arena -->
  <div class="card" style="padding: 28px; display: flex; flex-direction: column; gap: 20px;">
    <!-- Passage Display with Live Character Diff Highlighting -->
    <div id="typingPassageContainer" style="font-family: 'JetBrains Mono', monospace; font-size: 1.18rem; line-height: 1.85; padding: 24px; border-radius: 14px; background: var(--surface-3); border: 1px solid var(--border); min-height: 110px; user-select: none;">
      <!-- Characters will be dynamically rendered here with .correct, .incorrect, .pending, .current -->
    </div>

    <!-- User Keystroke Input -->
    <div>
      <input
        id="typingInputBox"
        type="text"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        class="field"
        placeholder="Start typing here to activate live telemetry cadence..."
        style="height: 48px; font-size: 1rem; font-family: 'JetBrains Mono', monospace; padding: 0 18px; border-radius: 12px; border: 1px solid var(--border); background: var(--surface-2);"
      />
    </div>

    <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.8rem; color: var(--text-muted);">
      <span id="typingPlaceholderTip"><i class="fas fa-info-circle"></i> Keystrokes are evaluated in real time at 120ms intervals.</span>
      <span id="typingStreakCounter" style="font-weight: 700; color: var(--accent-bright);">Streak: 0</span>
    </div>
  </div>

  <!-- Past Runs History in this session -->
  <div class="card" style="padding: 24px;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
      <div class="label-sm">Session Run Ledger</div>
      <span style="font-size: 0.75rem; color: var(--text-faint);">Latest 8 attempts</span>
    </div>
    <div id="typingRunsList" style="display: flex; flex-direction: column; gap: 8px;">
      <div style="font-size: 0.82rem; color: var(--text-faint); padding: 12px; text-align: center; background: var(--surface-2); border-radius: 10px;">
        Complete a run to save telemetry to your session profile.
      </div>
    </div>
  </div>

</div>
{{end}}
