{{define "arena_reading"}}
<div id="view-activity-reading" class="page-view flex-col-fill" style="gap: 20px; padding-bottom: 48px; display: none;">

  <!-- Hero Header -->
  <div class="card" style="padding: 24px 28px; background: linear-gradient(135deg, var(--surface), var(--surface-2)); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px;">
    <div>
      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
        <span class="badge" style="background: rgba(132, 204, 22, 0.15); color: #a3e635;">COMPREHENSION LAB</span>
        <span style="font-size: 0.72rem; font-weight: 700; color: #a3e635; background: rgba(132, 204, 22, 0.1); border: 1px solid rgba(132, 204, 22, 0.2); padding: 2px 8px; border-radius: 999px;">
          Analytical Reading
        </span>
      </div>
      <div class="display-title" style="font-size: 1.45rem; color: var(--text);">Reading Intel: Architectural Comprehension</div>
    </div>
    <div style="display: flex; align-items: center; gap: 8px;">
      <button id="readingNextPassageBtn" class="btn btn-secondary btn-sm" style="border-radius: 9999px; gap: 6px;">
        Next Passage →
      </button>
      <a href="#/activities" class="btn btn-ghost btn-sm" style="border-radius: 9999px;">Exit</a>
    </div>
  </div>

  <!-- Passage Selector Tabs -->
  <div id="readingPassageTabs" style="display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px;">
    <!-- Populated dynamically via Go WASM -->
  </div>

  <!-- HUD: Reading Rate, Score, Accuracy -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px;">
    <div class="metric-box" style="text-align: center;">
      <div class="label-sm" style="margin-bottom: 4px;">Reading Velocity</div>
      <div id="readingWpmDisplay" style="font-size: 2rem; font-weight: 800; color: #a3e635;">Reading...</div>
    </div>
    <div class="metric-box" style="text-align: center;">
      <div class="label-sm" style="margin-bottom: 4px;">Comprehension Score</div>
      <div id="readingScoreDisplay" style="font-size: 2rem; font-weight: 800; color: var(--accent-bright);">0 pts</div>
    </div>
    <div class="metric-box" style="text-align: center;">
      <div class="label-sm" style="margin-bottom: 4px;">Accuracy</div>
      <div id="readingAccuracyDisplay" style="font-size: 2rem; font-weight: 800; color: #38bdf8;">-</div>
    </div>
    <div class="metric-box" style="text-align: center;">
      <div class="label-sm" style="margin-bottom: 4px;">Passage Length</div>
      <div id="readingWordCountBadge" style="font-size: 2rem; font-weight: 800; color: var(--text);">300 words</div>
    </div>
  </div>

  <!-- Reading Surface -->
  <div class="card" style="padding: 36px 32px; display: flex; flex-direction: column; gap: 20px;">
    <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border-subtle); padding-bottom: 12px;">
      <span id="readingCategoryBadge" class="badge" style="background: rgba(132, 204, 22, 0.15); color: #a3e635;">
        Distributed Systems
      </span>
      <span style="font-size: 0.78rem; color: var(--text-faint);">
        Telemetry timer running
      </span>
    </div>

    <div id="readingTitleDisplay" style="font-size: 1.4rem; font-weight: 800; color: var(--text); line-height: 1.35;">
      Loading Passage Title...
    </div>

    <div id="readingPassageBody" style="font-size: 0.98rem; color: var(--text); line-height: 1.85; white-space: pre-line; background: var(--surface-2); padding: 24px; border-radius: 14px; border: 1px solid var(--border-subtle);">
      Loading passage content...
    </div>

    <div style="display: flex; justify-content: flex-end; margin-top: 4px;">
      <button id="readingDoneBtn" class="btn btn-primary btn-sm" style="height: 42px; padding: 0 24px; border-radius: 12px; font-weight: 700; gap: 8px;">
        <i class="fas fa-check"></i> I Have Finished Reading — Start Questions
      </button>
    </div>
  </div>

  <!-- Questions Section -->
  <div id="readingQuestionsContainer" class="card" style="padding: 32px; display: none; flex-direction: column; gap: 20px;">
    <div style="display: flex; align-items: center; justify-content: space-between;">
      <div style="font-size: 1.2rem; font-weight: 800; color: var(--text);">
        Comprehension &amp; Architectural Inferences
      </div>
      <span class="badge" style="background: rgba(132, 204, 22, 0.15); color: #a3e635;">Verification Phase</span>
    </div>

    <div id="readingQuestionsFeed" style="display: flex; flex-direction: column; gap: 16px;">
      <!-- Populated via Go WASM -->
    </div>

    <div style="display: flex; justify-content: flex-end; margin-top: 12px;">
      <button id="readingSubmitBtn" class="btn btn-primary btn-sm" style="height: 42px; padding: 0 24px; border-radius: 12px; font-weight: 700;">
        Submit Verification Answers
      </button>
    </div>

    <div id="readingFeedbackFeed">
      <!-- Answers & rationales feed -->
    </div>
  </div>

</div>
{{end}}
