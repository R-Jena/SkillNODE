            <div>
              <div class="hero-kicker" style="font-size: 0.7rem; letter-spacing: 0.12em;">Access Gateway</div>
              <h2 id="landingAuthTitle" style="font-size: 1.35rem; font-weight: 800; color: var(--text); margin: 3px 0 0;">
                Sign in to SkillNODE
              </h2>
            </div>
            <div style="width: 10px; height: 10px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px var(--accent);"></div>
          </div>

          <!-- Mode Switcher Tabs -->
