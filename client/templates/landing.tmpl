            <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 2px;">Local Latency</div>
          </div>
          <div>
            <div style="font-size: 1.4rem; font-weight: 800; color: var(--accent-bright);">6 Tracks</div>
            <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 2px;">Multi-Domain</div>
          </div>
          <div>
            <div style="font-size: 1.4rem; font-weight: 800; color: var(--text);">100%</div>
            <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 2px;">Fair-Play Verify</div>
          </div>
        </div>
      </div>

      <!-- Right Column: Access Gateway Card -->
      <div id="auth-portal" style="display: flex; justify-content: center;">
        <div class="login-card" style="width: 100%; max-width: 440px;">
          
