    <div style="display: flex; align-items: center; gap: 12px;">
      <img src="logo.png" alt="SkillNODE logo" style="width: 34px; height: 34px; border-radius: 50%; object-fit: contain;">
      <span style="font-size: 1.2rem; font-weight: 800; letter-spacing: -0.03em; color: var(--text);">
        Skill<span style="color: var(--accent-bright);">NODE</span>
      </span>
    </div>

    <nav style="display: flex; align-items: center; gap: 20px;" class="landing-desktop-nav">
      <a href="#tracks" class="flutter-nav-link" id="navLinkTracks" style="color: var(--text-muted); text-decoration: none; font-size: 0.875rem; font-weight: 600; cursor: pointer;">Skill Tracks</a>
      <a href="#features" class="flutter-nav-link" id="navLinkFeatures" style="color: var(--text-muted); text-decoration: none; font-size: 0.875rem; font-weight: 600; cursor: pointer;">Architecture</a>
      <a href="#benchmarks" class="flutter-nav-link" id="navLinkBenchmarks" style="color: var(--text-muted); text-decoration: none; font-size: 0.875rem; font-weight: 600; cursor: pointer;">Capabilities</a>
    </nav>

    <div style="display: flex; align-items: center; gap: 12px;">
      <button id="landingThemeBtn" class="btn btn-ghost btn-sm" title="Toggle theme" style="display: flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 9999px; border: 1px solid var(--border-subtle); color: var(--text);">
        <i id="landingThemeIcon" class="fas fa-sun"></i>
        <span id="landingThemeLabel" style="font-size: 0.8rem; font-weight: 600;">Theme</span>
      </button>
      <button id="landingNavGetStartedBtn" class="btn btn-primary btn-sm" style="padding: 0 18px; height: 36px; font-size: 0.825rem; font-weight: 700;">
        Get Started
      </button>
