            <button type="button" id="landingTabSignIn" class="landing-tab-btn active" style="flex: 1; padding: 7px 12px; border-radius: 9999px; border: none; background: var(--btn-bg); color: #fff; font-size: 0.8rem; font-weight: 700; cursor: pointer; transition: all 0.18s ease;">
