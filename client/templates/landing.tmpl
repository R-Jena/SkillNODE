            <button type="submit" id="landingLoginSubmitBtn" class="btn btn-primary btn-lg mt-2" style="width: 100%; height: 46px; font-size: 0.95rem; font-weight: 700;">
              Enter SkillNODE &rarr;
            </button>

            <div style="display: flex; align-items: center; justify-content: space-between; margin: 4px 0;">
              <div style="height: 1px; flex: 1; background: var(--border-subtle);"></div>
              <span style="font-size: 0.75rem; color: var(--text-faint); padding: 0 10px;">OR</span>
              <div style="height: 1px; flex: 1; background: var(--border-subtle);"></div>
            </div>

            <button type="button" id="landingDemoBtn" class="btn btn-secondary" style="width: 100%; font-size: 0.825rem; font-weight: 700; height: 44px; display: flex; align-items: center; justify-content: center; gap: 8px;">
              <i class="fas fa-bolt" style="color: var(--accent);"></i>
              Instant Demo Access (0-Click Entry)
            </button>
          </form>

          <!-- SIGN UP FORM -->
          <form id="landingSignUpForm" style="display: none; flex-direction: column; gap: 12px;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
              <div>
                <label style="display: flex; align-items: center; gap: 6px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-faint); margin-bottom: 6px;">
                  <i class="fas fa-user" style="color: var(--accent); font-size: 11px;"></i> Full Name
                </label>
                <input id="landingSignupName" type="text" class="input" placeholder="Alex Chen" required style="width: 100%; box-sizing: border-box;">
              </div>
              <div>
                <label style="display: flex; align-items: center; gap: 6px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-faint); margin-bottom: 6px;">
                  <i class="fas fa-at" style="color: var(--accent); font-size: 11px;"></i> Username
                </label>
                <input id="landingSignupUsername" type="text" class="input" placeholder="alex_coder" required style="width: 100%; box-sizing: border-box;">
              </div>
            </div>

            <div>
              <label style="display: flex; align-items: center; gap: 6px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-faint); margin-bottom: 6px;">
                <i class="fas fa-envelope" style="color: var(--accent); font-size: 11px;"></i> Email Address
              </label>
              <input id="landingSignupEmail" type="email" class="input" placeholder="alex@domain.com" required style="width: 100%; box-sizing: border-box;">
            </div>

            <div>
              <label style="display: flex; align-items: center; gap: 6px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-faint); margin-bottom: 6px;">
                <i class="fas fa-lock" style="color: var(--accent); font-size: 11px;"></i> Password
              </label>
              <div style="position: relative;">
                <input id="landingSignupPassword" type="password" class="input" placeholder="Create a strong password" required style="width: 100%; box-sizing: border-box; padding-right: 40px;">
                <button type="button" id="landingSignupTogglePwd" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--text-faint); cursor: pointer; display: flex; align-items: center;">
                  <i id="landingSignupPwdIcon" class="fas fa-eye"></i>
                </button>
              </div>
            </div>

            <div>
              <label style="display: flex; align-items: center; gap: 6px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-faint); margin-bottom: 6px;">
                <i class="fas fa-map-marker-alt" style="color: var(--accent); font-size: 11px;"></i> Region / Location
              </label>
              <input id="landingSignupRegion" type="text" class="input" placeholder="e.g. San Francisco, CA / Global" style="width: 100%; box-sizing: border-box;">
            </div>

            <button type="submit" id="landingSignupSubmitBtn" class="btn btn-primary btn-lg mt-2" style="width: 100%; height: 46px; font-size: 0.95rem; font-weight: 700;">
              Create Account &amp; Enter &rarr;
            </button>
          </form>

        </div>
      </div>

    </div>
  </section>

  <!-- ── Section 1: Interactive Surface Showcase ── -->
  <section id="interactive" style="position: relative; z-index: 1; padding: 40px 24px 80px; max-width: 1240px; margin: 0 auto; width: 100%; box-sizing: border-box;">
    <div style="text-align: center; margin-bottom: 40px;">
      <span class="flutter-pill-tag">Interactive Surface</span>
      <h2 class="display-title" style="font-size: 2.4rem; color: var(--text); margin-top: 10px; font-weight: 800;">
        Unified execution across every track.
      </h2>
      <p style="color: var(--text-muted); font-size: 1rem; max-width: 620px; margin: 8px auto 0;">
        Experience instant feedback loops whether you are writing algorithm solutions, racing typing speed, or competing in multiplayer lobbies.
      </p>
    </div>

    <!-- 3-Card Floating Showcase Perspective -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; align-items: stretch;">
      
      <!-- Mockup 1: Code Arena -->
      <div class="showcase-screen" style="padding: 24px;">
        <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border-subtle); padding-bottom: 12px; margin-bottom: 16px;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <i class="fas fa-code" style="color: var(--accent);"></i>
            <span style="font-size: 0.85rem; font-weight: 700; color: var(--text);">Code Arena (JavaScript)</span>
          </div>
          <span class="badge" style="border-radius: 9999px;">Pass: 3/3 Tests</span>
        </div>
        <pre style="background: var(--surface-2); padding: 16px; border-radius: 12px; border: 1px solid var(--border-subtle); font-size: 0.78rem; color: #c084fc; margin: 0; line-height: 1.6; font-family: 'JetBrains Mono', monospace; overflow-x: auto;">function mergeIntervals(intervals) {
  if (!intervals.length) return [];
  intervals.sort((a, b) => a[0] - b[0]);
  const merged = [intervals[0]];
  for (let i = 1; i &lt; intervals.length; i++) {
    const prev = merged[merged.length - 1];
    if (intervals[i][0] &lt;= prev[1]) {
      prev[1] = Math.max(prev[1], intervals[i][1]);
    } else {
      merged.push(intervals[i]);
    }
  }
  return merged; // Complexity O(N log N)
}</pre>
        <div style="display: flex; gap: 8px; margin-top: 14px;">
          <span style="font-size: 0.72rem; color: var(--text-muted); background: var(--surface-3); padding: 4px 10px; border-radius: 9999px;">Memory: 14.2 MB</span>
          <span style="font-size: 0.72rem; color: var(--text-muted); background: var(--surface-3); padding: 4px 10px; border-radius: 9999px;">Latency: 1.2 ms</span>
        </div>
      </div>

      <!-- Mockup 2: Typing Race -->
      <div class="showcase-screen" style="padding: 24px;">
        <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border-subtle); padding-bottom: 12px; margin-bottom: 16px;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <i class="fas fa-stopwatch" style="color: #38bdf8;"></i>
            <span style="font-size: 0.85rem; font-weight: 700; color: var(--text);">Typing Velocity Telemetry</span>
          </div>
          <span class="badge" style="border-radius: 9999px; background: rgba(56,189,248,0.15); color: #38bdf8; border-color: rgba(56,189,248,0.3);">
            Rank 1 &bull; Master
          </span>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
          <div style="background: var(--surface-2); padding: 14px; border-radius: 12px; border: 1px solid var(--border-subtle); text-align: center;">
            <div style="font-size: 2rem; font-weight: 800; color: var(--text);">124</div>
            <div style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase;">Net WPM</div>
          </div>
          <div style="background: var(--surface-2); padding: 14px; border-radius: 12px; border: 1px solid var(--border-subtle); text-align: center;">
            <div style="font-size: 2rem; font-weight: 800; color: var(--accent-bright);">99.6%</div>
            <div style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase;">Accuracy</div>
          </div>
        </div>
        <div style="background: var(--surface-2); padding: 12px; border-radius: 10px; font-size: 0.8rem; color: var(--text-muted); line-height: 1.6;">
          &ldquo;The architecture of deterministic systems is designed to eliminate non-reproducible states at runtime...&rdquo;
        </div>
      </div>

      <!-- Mockup 3: Multiplayer Duel -->
      <div class="showcase-screen" style="padding: 24px;">
        <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border-subtle); padding-bottom: 12px; margin-bottom: 16px;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <i class="fas fa-gamepad" style="color: #ec4899;"></i>
            <span style="font-size: 0.85rem; font-weight: 700; color: var(--text);">Realtime Multiplayer Battle</span>
          </div>
          <span style="font-size: 0.72rem; color: #4ade80; display: flex; align-items: center; gap: 4px;">
            <span style="width: 6px; height: 6px; border-radius: 50%; background: #4ade80;"></span> Socket Live
          </span>
        </div>
        <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 8px;">
          <div style="display: flex; align-items: center; justify-content: space-between; padding: 10px 12px; background: var(--surface-2); border-radius: 10px; border: 1px solid var(--border-subtle);">
            <span style="font-size: 0.825rem; font-weight: 700; color: var(--text);">1. Alex Coder (You)</span>
            <span style="font-size: 0.825rem; font-weight: 700; color: var(--accent-bright);">1,480 pts</span>
          </div>
          <div style="display: flex; align-items: center; justify-content: space-between; padding: 10px 12px; background: var(--surface-2); border-radius: 10px; border: 1px solid var(--border-subtle);">
            <span style="font-size: 0.825rem; color: var(--text-muted);">2. Maya Lin (MIT)</span>
            <span style="font-size: 0.825rem; color: var(--text-muted);">1,410 pts</span>
          </div>
          <div style="display: flex; align-items: center; justify-content: space-between; padding: 10px 12px; background: var(--surface-2); border-radius: 10px; border: 1px solid var(--border-subtle);">
            <span style="font-size: 0.825rem; color: var(--text-muted);">3. David Kim (Google)</span>
            <span style="font-size: 0.825rem; color: var(--text-muted);">1,320 pts</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Section 2: Six Supported Tracks ── -->
  <section id="tracks" style="position: relative; z-index: 1; padding: 60px 24px; max-width: 1240px; margin: 0 auto; width: 100%; box-sizing: border-box;">
    <div style="text-align: center; margin-bottom: 36px;">
