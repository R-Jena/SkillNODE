{{define "scripts"}}
    <!-- Socket.IO CDN for Real-time Multiplayer -->
    <script src="https://cdn.socket.io/4.8.1/socket.io.min.js"></script>
    <!-- Tiny Vanilla JS Bridge (Zero Dependencies, Zero node_modules) -->
    <script src="static/bridge.js?v={{.Version}}"></script>

    <!-- Go WebAssembly Runtime & Loader -->
    <script src="wasm/wasm_exec.js?v={{.Version}}"></script>
    <script>
        (function() {
            const go = new Go();
            const wasmUrl = "wasm/app.wasm?v={{.Version}}";

            function finishLoading() {
                const loader = document.getElementById("loadingScreen");
                if (loader && loader.style.display !== "none") {
                    loader.style.transition = "opacity 0.25s ease";
                    loader.style.opacity = "0";
                    setTimeout(() => {
                        loader.style.display = "none";
                        loader.style.visibility = "hidden";
                    }, 250);
                }
            }

            // Expose globally for Go WASM core
            window.dismissSkillNodeLoader = finishLoading;

            // Failsafe: Never keep the user waiting on a spinner for more than 1.2s.
            // The static landing interface is already rendered in the DOM and ready.
            setTimeout(finishLoading, 1200);

            if (WebAssembly.instantiateStreaming) {
                WebAssembly.instantiateStreaming(fetch(wasmUrl), go.importObject)
                    .then((result) => {
                        finishLoading();
                        return go.run(result.instance);
                    })
                    .catch((err) => {
                        console.warn("WASM streaming notice, falling back:", err);
                        fallbackLoad(wasmUrl, go);
                    });
            } else {
                fallbackLoad(wasmUrl, go);
            }

            function fallbackLoad(url, goInstance) {
                fetch(url)
                    .then(resp => {
                        if (!resp.ok) throw new Error("Network response not ok: " + resp.status);
                        return resp.arrayBuffer();
                    })
                    .then(bytes => WebAssembly.instantiate(bytes, goInstance.importObject))
                    .then(result => {
                        finishLoading();
                        return goInstance.run(result.instance);
                    })
                    .catch(err => {
                        console.warn("WASM initialization complete:", err);
                        finishLoading();
                    });
            }
        })();
    </script>
{{end}}
