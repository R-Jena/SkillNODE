{{define "app_sidebar"}}
<aside class="sidebar" style="padding: 0; height: 100%; max-height: 100%; display: flex; flex-direction: column;">
  <!-- Logo + branding -->
  <div class="shell-brand" style="padding: 16px 16px 12px; border-bottom: 1px solid var(--border-subtle); flex-shrink: 0;">
    <div class="shell-brand-lockup" style="display: flex; align-items: center; gap: 10px;">
      <img src="logo.png" alt="SkillNODE" style="width: 34px; height: 34px; border-radius: 50%; object-fit: contain;">
      <div>
        <div class="hero-kicker" style="font-size: 0.625rem; letter-spacing: 0.14em;">Skill Arena</div>
        <div class="display-title" style="font-size: 1.1rem; line-height: 1.15; color: var(--text);">SkillNODE</div>
      </div>
    </div>
  </div>

  <!-- Player Identity Card -->
  <div class="shell-player-card" style="margin: 12px 12px 8px; padding: 12px; background: var(--surface-2); border: 1px solid var(--border-subtle); border-radius: 16px; flex-shrink: 0;">
    <div class="label-sm" style="margin-bottom: 8px; fontSize: 0.68rem;">Operator</div>
    <div class="shell-player-main" style="display: flex; align-items: center; gap: 10px;">
      <div id="sidebarAvatar" style="width: 36px; height: 36px; border-radius: 50%; background: var(--accent); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.9rem; flex-shrink: 0; border: 2px solid var(--border);">
        O
      </div>
      <div style="min-width: 0; flex: 1;">
        <div id="sidebarPlayerName" style="font-size: 0.875rem; font-weight: 700; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
          Operator
        </div>
        <div id="sidebarPlayerHandle" style="font-size: 0.72rem; color: var(--accent-bright); margin-top: 1px; font-weight: 600;">
          @operator
        </div>
      </div>
    </div>
    <!-- Status pills -->
    <div class="shell-status-row" style="display: flex; gap: 6px; margin-top: 10px;">
      <div class="shell-status-pill" style="flex: 1; padding: 5px 8px; background: var(--surface); border: 1px solid var(--border-subtle); border-radius: 9999px; display: flex; align-items: center; justify-content: center; gap: 5px;">
        <i class="fas fa-shield-alt" style="color: var(--accent); font-size: 11px;"></i>
        <span style="font-size: 0.68rem; color: var(--text-muted); font-weight: 600;">Fair play</span>
      </div>
      <div class="shell-status-pill" style="flex: 1; padding: 5px 8px; background: var(--surface); border: 1px solid var(--border-subtle); border-radius: 9999px; display: flex; align-items: center; justify-content: center; gap: 5px;">
        <span class="status-dot" style="width: 6px; height: 6px;"></span>
        <span style="font-size: 0.68rem; color: var(--text-muted); font-weight: 600;">Live</span>
      </div>
    </div>
  </div>

  <!-- Navigation items -->
  <nav class="shell-nav" style="padding: 8px 12px; flex: 1; overflow-y: auto;">
    <a href="#/dashboard" class="nav-item active" data-nav="dashboard">
      <i class="fas fa-th-large" style="width: 18px; text-align: center;"></i>
      <span>Dashboard</span>
    </a>
    <a href="#/activities" class="nav-item" data-nav="activities">
      <i class="fas fa-trophy" style="width: 18px; text-align: center;"></i>
      <span>Skill Labs</span>
    </a>
    <a href="#/multiplayer" class="nav-item" data-nav="multiplayer">
      <i class="fas fa-gamepad" style="width: 18px; text-align: center;"></i>
      <span>Multiplayer</span>
    </a>
    <a href="#/profile" class="nav-item" data-nav="profile">
      <i class="fas fa-user-circle" style="width: 18px; text-align: center;"></i>
      <span>Profile</span>
    </a>
  </nav>

  <!-- Footer Actions -->
  <div class="shell-footer" style="padding: 12px 14px; border-top: 1px solid var(--border-subtle); display: flex; align-items: center; justify-content: space-between; flex-shrink: 0;">
    <button id="toggleThemeBtn" class="btn btn-ghost btn-sm shell-theme-toggle" title="Toggle Theme" style="padding: 6px 10px;">
      <i id="themeIcon" class="fas fa-moon"></i>
    </button>
    <button id="authTriggerBtn" class="btn btn-ghost btn-sm" style="font-size: 0.78rem; gap: 6px;">
      <i class="fas fa-sign-in-alt"></i>
      <span id="authBtnLabel">Sign In</span>
    </button>
  </div>
</aside>
{{end}}
