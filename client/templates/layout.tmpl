{{define "layout"}}<!DOCTYPE html>
<html lang="en" data-theme="dark-purple">
{{template "head" .}}
<body class="bg-slate-950 text-slate-100" style="margin: 0; padding: 0; overflow: hidden;">
{{template "loading" .}}
{{template "auth_modal" .}}

{{template "landing" .}}

    <div id="root" class="app-shell" style="display: none; flex-direction: column; height: 100vh; height: 100dvh; overflow: hidden; width: 100%;">
        {{template "app_header" .}}

        <div style="display: flex; flex: 1; min-height: 0; overflow: hidden; width: 100%;">
            {{template "app_sidebar" .}}

            <main class="main-area" style="flex: 1; display: flex; flex-direction: column; height: 100%; max-height: 100%; overflow: hidden; min-width: 0;">
                <div id="pageFrame" class="page-frame" style="flex: 1; overflow-y: auto; overflow-x: hidden; padding: 28px 36px 64px; display: flex; flex-direction: column; gap: 24px; min-height: 0;">
                    {{template "dashboard" .}}
                    {{template "activities" .}}
                    {{template "arena_typing" .}}
                    {{template "arena_code" .}}
                    {{template "arena_math" .}}
                    {{template "arena_guess" .}}
                    {{template "arena_grammar" .}}
                    {{template "arena_reading" .}}
                    {{template "arena_multiplayer" .}}
                    {{template "profile" .}}
                </div>
            </main>
        </div>
    </div>

{{template "app_toast" .}}
{{template "scripts" .}}
</body>
</html>
{{end}}
