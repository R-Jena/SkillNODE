{{define "app_header"}}
<!-- Top Announcement Banner -->
<div class="flutter-banner" style="flex-shrink: 0; padding: 6px 16px; font-size: 0.78rem;">
  <span>⚡ SkillNODE 2026 Engine is live! Advanced coding arena, real-time presence & AI telemetry active.</span>
</div>

<!-- Top Bar -->
<header class="top-bar">
  <div style="display: flex; align-items: center; gap: 12px; flex: 1;">
    <div class="top-bar-title">
      <i class="fas fa-terminal" style="color: var(--accent); font-size: 13px;"></i>
      <span id="currentViewTitle" style="font-size: 0.82rem; font-weight: 700; color: var(--text);">Dashboard</span>
    </div>
    <div class="top-bar-live" style="display: flex; align-items: center; gap: 6px; font-size: 0.72rem; font-weight: 700;">
      <span class="status-dot" style="width: 6px; height: 6px;"></span>
      <span>SYSTEM ONLINE</span>
    </div>
  </div>

  <div style="display: flex; align-items: center; gap: 10px;">
    <a href="#/activities/typing" class="btn btn-primary btn-sm" style="height: 32px; font-size: 0.78rem; padding: 0 14px; gap: 6px;">
      <i class="fas fa-keyboard"></i>
      <span>Quick Race</span>
    </a>
  </div>
</header>
{{end}}
