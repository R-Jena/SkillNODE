{{define "head"}}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <meta name="description" content="{{.Description}}">
    <meta name="theme-color" content="#07070f">
    <title>{{.Title}}</title>
    <link rel="icon" type="image/png" href="logo.png">
    
    <!-- Google Fonts: Plus Jakarta Sans, Roboto & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Roboto:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome & Lucide Icon Styles -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Compiled SkillNODE Production Stylesheet -->
    <link rel="stylesheet" href="styles.css?v={{.Version}}">

    <script>
      // Apply stored theme before first paint to avoid theme flash
      try {
        const t = localStorage.getItem("skillnode-theme");
        if (t === "light-blue" || t === "light") {
          document.documentElement.setAttribute("data-theme", "light-white");
        } else if (t) {
          document.documentElement.setAttribute("data-theme", t);
        } else {
          document.documentElement.setAttribute("data-theme", "dark-purple");
        }
      } catch (e) {}
    </script>
</head>
{{end}}
